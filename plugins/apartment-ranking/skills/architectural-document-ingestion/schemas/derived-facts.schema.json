{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architectural Derived Facts",
  "type": "object",
  "required": ["schema_version", "facts"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "entity_type", "entity_id", "field", "value", "confidence", "evidence"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "entity_type": {"type": "string", "minLength": 1},
          "entity_id": {"type": ["string", "number"]},
          "field": {"type": "string", "minLength": 1},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "note"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "page_number": {"type": ["integer", "null"], "minimum": 1},
                "crop_path": {"type": ["string", "null"]},
                "note": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "depends_on_source_hashes": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
